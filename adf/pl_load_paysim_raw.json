{
    "name": "pl_load_paysim_raw",
    "properties": {
        "activities": [
            {
                "name": "copy_paysim_to_raw",
                "type": "Copy",
                "dependsOn": [],
                "policy": {
                    "timeout": "0.12:00:00",
                    "retry": 0,
                    "retryIntervalInSeconds": 30,
                    "secureOutput": false,
                    "secureInput": false
                },
                "userProperties": [],
                "typeProperties": {
                    "source": {
                        "type": "DelimitedTextSource",
                        "additionalColumns": [
                            {
                                "name": "source_file",
                                "value": "$$FILEPATH"
                            }
                        ],
                        "storeSettings": {
                            "type": "AzureBlobFSReadSettings",
                            "recursive": true,
                            "enablePartitionDiscovery": false
                        },
                        "formatSettings": {
                            "type": "DelimitedTextReadSettings"
                        }
                    },
                    "sink": {
                        "type": "AzureSqlSink",
                        "preCopyScript": "TRUNCATE TABLE raw.paysim_transactions;",
                        "writeBehavior": "insert",
                        "sqlWriterUseTableLock": false,
                        "disableMetricsCollection": false
                    },
                    "enableStaging": false,
                    "translator": {
                        "type": "TabularTranslator",
                        "mappings": [
                            {
                                "source": {
                                    "name": "step",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "step",
                                    "type": "Int32",
                                    "physicalType": "int"
                                }
                            },
                            {
                                "source": {
                                    "name": "type",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "type",
                                    "type": "String",
                                    "physicalType": "nvarchar"
                                }
                            },
                            {
                                "source": {
                                    "name": "amount",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "amount",
                                    "type": "Decimal",
                                    "physicalType": "decimal",
                                    "scale": 2,
                                    "precision": 18
                                }
                            },
                            {
                                "source": {
                                    "name": "nameOrig",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "nameOrig",
                                    "type": "String",
                                    "physicalType": "nvarchar"
                                }
                            },
                            {
                                "source": {
                                    "name": "oldbalanceOrg",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "oldbalanceOrg",
                                    "type": "Decimal",
                                    "physicalType": "decimal",
                                    "scale": 2,
                                    "precision": 18
                                }
                            },
                            {
                                "source": {
                                    "name": "newbalanceOrig",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "newbalanceOrig",
                                    "type": "Decimal",
                                    "physicalType": "decimal",
                                    "scale": 2,
                                    "precision": 18
                                }
                            },
                            {
                                "source": {
                                    "name": "nameDest",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "nameDest",
                                    "type": "String",
                                    "physicalType": "nvarchar"
                                }
                            },
                            {
                                "source": {
                                    "name": "oldbalanceDest",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "oldbalanceDest",
                                    "type": "Decimal",
                                    "physicalType": "decimal",
                                    "scale": 2,
                                    "precision": 18
                                }
                            },
                            {
                                "source": {
                                    "name": "newbalanceDest",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "newbalanceDest",
                                    "type": "Decimal",
                                    "physicalType": "decimal",
                                    "scale": 2,
                                    "precision": 18
                                }
                            },
                            {
                                "source": {
                                    "name": "isFraud",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "isFraud",
                                    "type": "Byte",
                                    "physicalType": "tinyint"
                                }
                            },
                            {
                                "source": {
                                    "name": "isFlaggedFraud",
                                    "type": "String",
                                    "physicalType": "String"
                                },
                                "sink": {
                                    "name": "isFlaggedFraud",
                                    "type": "Byte",
                                    "physicalType": "tinyint"
                                }
                            },
                            {
                                "source": {
                                    "name": "source_file",
                                    "type": "String"
                                },
                                "sink": {
                                    "name": "source_file",
                                    "type": "String",
                                    "physicalType": "nvarchar"
                                }
                            }
                        ],
                        "typeConversion": true,
                        "typeConversionSettings": {
                            "allowDataTruncation": true,
                            "treatBooleanAsNumber": false
                        }
                    }
                },
                "inputs": [
                    {
                        "referenceName": "ds_paysim_csv",
                        "type": "DatasetReference"
                    }
                ],
                "outputs": [
                    {
                        "referenceName": "ds_sql_raw_paysim",
                        "type": "DatasetReference"
                    }
                ]
            }
        ],
        "annotations": []
    }
}
